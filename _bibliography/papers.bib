  doi = {10.1093/llc/fqab004},
  urldate = {2023-02-05},
  abstract = {This article provides insights into dealing with complexities in the Digital Humanities project exploreAT!. By exploring a non-standard language collection for cultural insights, a three-fold approach is presented looking into concrete realizations and solutions of tackling challenges in terms of Open Innovation infrastructure, technology and the topic of choice, food. Methods and processes applied and developed in the project are aimed to serve as examples for future projects with similar data sets.},
  copyright = {All rights reserved},
}

